<nav class="nav">
  <div class="nav__inner">
    <a href="/<%= I18n.locale %>" class="nav__logo">
      <img src="/images/icon.png" alt="Topotree" width="28" height="28">
      <span>Topotree</span>
    </a>

    <div class="nav__links">
      <a href="#how-it-works"><%= t('nav.how_it_works') %></a>
      <a href="#pricing"><%= t('nav.pricing') %></a>
      <a href="#faq">FAQ</a>
    </div>

    <div class="nav__right">
      <select class="lang-select" onchange="window.location.href='/'+this.value">
        <option value="en" <%= 'selected' if I18n.locale == :en %>>English</option>
        <option value="fr" <%= 'selected' if I18n.locale == :fr %>>Français</option>
        <option value="de" <%= 'selected' if I18n.locale == :de %>>Deutsch</option>
        <option value="es" <%= 'selected' if I18n.locale == :es %>>Español</option>
        <option value="it" <%= 'selected' if I18n.locale == :it %>>Italiano</option>
        <option value="pt" <%= 'selected' if I18n.locale == :pt %>>Português</option>
        <option value="nl" <%= 'selected' if I18n.locale == :nl %>>Nederlands</option>
        <option value="pl" <%= 'selected' if I18n.locale == :pl %>>Polski</option>
        <option value="ja" <%= 'selected' if I18n.locale == :ja %>>日本語</option>
      </select>

      <a href="https://gumroad.com/l/topotree" class="btn btn--sm btn--green" target="_blank" rel="noopener">
        <%= t('nav.download') %>
      </a>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow"><%= t('hero.eyebrow') %></p>
    <h1 class="hero__title"><%= t('hero.title') %></h1>
    <p class="hero__sub"><%= t('hero.sub') %></p>
    <div class="hero__actions">
      <a href="https://gumroad.com/l/topotree" class="btn btn--lg" target="_blank" rel="noopener">
        <%= t('hero.cta') %>
      </a>
      <span class="hero__trial"><%= t('hero.trial') %></span>
    </div>
  </div>

  <div class="hero__screenshot">
    <img src="/images/screenshot-treemap.png" alt="Topotree treemap view" class="hero__img">
  </div>
</section>

<!-- FEATURES -->
<section class="features" id="how-it-works">
  <div class="features__inner">
    <% [
      ['⚡', 'title1', 'body1'],
      ['🗺', 'title2', 'body2'],
      ['📅', 'title3', 'body3'],
      ['🗑', 'title4', 'body4'],
      ['⚡', 'title5', 'body5'],
      ['🌐', 'title6', 'body6'],
    ].each do |icon, title_key, body_key| %>
      <div class="feature">
        <div class="feature__icon"><%= icon %></div>
        <h3 class="feature__title"><%= t("features.#{title_key}") %></h3>
        <p class="feature__body"><%= t("features.#{body_key}") %></p>
      </div>
    <% end %>
  </div>
</section>

<!-- SCREENSHOTS -->
<section class="screenshots">
  <div class="screenshots__inner">
    <h2 class="screenshots__title"><%= t('screenshots.title') %></h2>
    <div class="screenshots__grid">
      <% [['ss1.png','cap1'],['ss2.png','cap2'],['ss3.png','cap3'],['ss4.png','cap4']].each do |img, cap| %>
        <figure class="screenshot-card">
          <img src="/images/<%= img %>" alt="<%= t("screenshots.#{cap}") %>">
          <figcaption><%= t("screenshots.#{cap}") %></figcaption>
        </figure>
      <% end %>
    </div>
  </div>
</section>

<!-- PRICING -->
<section class="pricing" id="pricing">
  <div class="pricing__inner">
    <h2 class="pricing__title"><%= t('pricing.title') %></h2>
    <p class="pricing__sub"><%= t('pricing.sub') %></p>

    <div class="pricing__card">
      <div class="pricing__amount">$9.99</div>
      <ul class="pricing__list">
        <% ['feature1','feature2','feature3','feature4'].each do |f| %>
          <li><%= t("pricing.#{f}") %></li>
        <% end %>
      </ul>
      <a href="https://gumroad.com/l/topotree" class="btn btn--lg btn--full" target="_blank" rel="noopener">
        <%= t('pricing.cta') %>
      </a>
      <p class="pricing__note"><%= t('pricing.note') %></p>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer__inner">
    <span>© 2026 <a href="https://galernestudio.com" target="_blank" rel="noopener">Galerne Studio</a></span>
    <span class="footer__sep">&middot;</span>
    <a href="<%= privacy_path %>">Privacy</a>
    <span class="footer__sep">&middot;</span>
    <a href="<%= terms_path %>">Terms</a>
    <span class="footer__sep">&middot;</span>
    <a href="<%= mentions_legales_path %>">Mentions légales</a>
    <span class="footer__sep">&middot;</span>
    <a href="<%= changelog_path %>">Changelog</a>
    <span class="footer__sep">&middot;</span>
    <a href="mailto:support@galernestudio.com"><%= t('footer.support') %></a>
  </div>
</footer>
