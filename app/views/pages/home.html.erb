<!-- FEATURES -->
<section class="features">
  <div class="features__inner">

    <div class="feature">
      <div class="feature__icon">⚡</div>
      <h3 class="feature__title">Scans in seconds</h3>
      <p class="feature__body">
        Reads the NTFS Master File Table directly — the same technique WizTree uses.
        A full 1 TB drive with 750,000 files in under 5 seconds.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">🗺</div>
      <h3 class="feature__title">Two views, same data</h3>
      <p class="feature__body">
        Switch between a treemap (bigger rectangle = more space) and a sunburst
        (rings show folder depth). Both update live as you drill in.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">📅</div>
      <h3 class="feature__title">Find forgotten files</h3>
      <p class="feature__body">
        Filter by age to show only files not touched in 1, 2, or 5+ years.
        No other disk analyzer offers this. Perfect for old downloads and project archives.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">🗑</div>
      <h3 class="feature__title">Clean up without fear</h3>
      <p class="feature__body">
        Right-click to send to the Recycle Bin. Use the Collector basket to queue
        items from different folders and review the total before deleting.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">⚡</div>
      <h3 class="feature__title">Instant history</h3>
      <p class="feature__body">
        Reopen any of your last 3 scans instantly without rescanning.
        A cleanup history dashboard tracks everything you've freed over time.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">🌐</div>
      <h3 class="feature__title">9 languages</h3>
      <p class="feature__body">
        English, French, German, Spanish, Italian, Portuguese, Dutch, Polish, Japanese.
        Light and dark theme. Text size S / M / L.
      </p>
    </div>

  </div>
</section>

